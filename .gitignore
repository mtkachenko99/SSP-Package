/data/experiment/doria2022_c8s3_nanotubes/raw/
/data/experiment/doria2022_c8s3_nanotubes/extracted/

# --- build trees and packages
/software/build/
/software/build-*/
/software/packaging/out/
/software/packaging/*.log

# --- quantum-chemistry environments (recreate: python -m venv, micromamba; see software/qc/README.md)
/software/qc/venv/
/software/qc/nwchem-env/
/software/qc/mamba/
/software/qc/bin/

# --- calculation results (reproducible from the configs)
/software/excitons/examples/results/
