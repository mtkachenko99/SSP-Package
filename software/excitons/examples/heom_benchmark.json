{
  "_comment": "Малые агрегаты: сравнение кумулянт+Редфилд с численно точным HEOM.",
  "output_dir": "results/heom_benchmark",
  "configurations": [
    {"name": "ring6", "geometry_type": "ring", "geometry_params": {"N": 6, "radius": 1.5, "tilt_deg": 0.0}},
    {"name": "chain6", "geometry_type": "linear_chain", "geometry_params": {"N": 6, "spacing": 1.0, "dipole_angle_deg": 0.0}}
