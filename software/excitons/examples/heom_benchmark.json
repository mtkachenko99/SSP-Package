  "ensemble": {"min_realizations": 16, "max_realizations": 64, "seed": 3},
  "dynamics": {"enabled": false},
  "heom": {"enabled": true, "matsubara": 1, "depth": 4, "t_max_ps": 1.0, "max_sites": 8,
           "absorption": true, "populations": true, "initial": "highest"}
